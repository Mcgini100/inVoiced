# Copy to .env and fill in. Never commit .env.

# Postgres connection string. docker compose sets this for the app container itself.
DATABASE_URL="postgresql://invoiced:invoiced@localhost:5432/invoiced?schema=public"

# Signs sign-in codes. At least 32 random characters: `openssl rand -base64 48`
AUTH_SECRET=

# How sign-in codes are delivered.
#   console : the code is written to the server log (development and closed pilots only).
# Leave empty in production to refuse sign-in until a real SMS/WhatsApp provider is added.
# In development, an empty value behaves like "console" and also shows the code on screen.
OTP_PROVIDER=

# Voice capture. Without a key the app still works for entries added by hand.
OPENAI_API_KEY=
# Model names are configuration, not code. Phase 1 changes these defaults (see docs/phase-0.md).
ASR_MODEL=whisper-1
# Optional ISO-639-1 hint, e.g. "en". Leave empty to let the model detect the language.
ASR_LANGUAGE=
EXTRACT_MODEL=gpt-4o-mini

# Voice captures allowed per business per day.
CAPTURE_DAILY_LIMIT=200
